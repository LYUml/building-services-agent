  "rules": [
    {
      "id": "HK.EMSD.BEC2024.load_design_conditions",
      "source_id": "emsd_bec_2024",
      "method": "hvac_load_design_conditions",
      "clause": "6.4.2 and Table 6.4",
      "pdf_page_1_based": 29,
      "printed_page": "23",
      "scope": "Indoor human-comfort and corresponding outdoor summer/winter load design conditions; not thermostat operating limits",
      "metric": "load_design_condition_limit_violations",
      "unit": "count",
      "applications": [
        "office",
        "classroom",
        "hotel",
        "other"
      ],
      "indoor_limits": {
        "summer": {
          "office": {
            "method": "minimum",
            "dry_bulb_degC": 23,
            "relative_humidity_percent": 50
          },
          "classroom": {
            "method": "minimum",
            "dry_bulb_degC": 23,
            "relative_humidity_percent": 50
          },
          "hotel": {
            "method": "minimum",
            "dry_bulb_degC": 22,
            "relative_humidity_percent": 50
          },
          "other": {
            "method": "minimum",
            "dry_bulb_degC": 22,
            "relative_humidity_percent": 50
          }
        },
        "winter": {
          "office": {
            "method": "maximum",
            "dry_bulb_degC": 22,
            "relative_humidity_percent": 50
          },
          "classroom": {
            "method": "maximum",
            "dry_bulb_degC": 22,
            "relative_humidity_percent": 50
          },
          "hotel": {
            "method": "maximum",
            "dry_bulb_degC": 24,
            "relative_humidity_percent": 50
          },
          "other": {
            "method": "maximum",
            "dry_bulb_degC": 22,
            "relative_humidity_percent": 50
          }
        }
      },
      "outdoor_limits": {
        "summer": {
          "dry_bulb_max_degC": 35,
          "wet_bulb_max_degC": 29
        },
        "winter": {
          "dry_bulb_min_degC": 7
        }
      },
      "applicability": [
        {
          "fact": "bec_air_conditioning_scope_confirmed",
          "equals": true
        },
        {
          "fact": "human_comfort_application",
          "equals": true
        },
        {
          "fact": "prescriptive_design_condition_route_selected",
          "equals": true
        },
        {
          "fact": "inputs_are_load_calculation_design_conditions",
          "equals": true
        }
      ],
      "alternative_path_note": "Selected Table 6.4 condition limits not met; review design basis and applicable compliance route. This is not a whole-project statutory determination."
    }
  ],
  "coverage": {
    "complete": false,
    "implemented": [
      "Human-comfort summer/winter indoor and outdoor Table 6.4 load-design limits"
    ],
    "pending": [
      "actual project scope and edition applicability",
      "recognized load-calculation method under 6.4.1",
      "binding design conditions to actual load engine inputs",
      "process-zone rules",
      "equipment efficiency, fan/pump limits, leakage, insulation and controls",
      "full HVAC and Hong Kong conformity"
    ]
  }
