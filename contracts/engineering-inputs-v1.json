{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "project_id", "scenario_id", "source_result", "source_request", "project_source", "parameters", "coverage", "scope", "source_assertions_authenticated", "design_accepted"],
  "properties": {
    "schema": {"const": "bsa.engineering-inputs/1"},
    "project_id": {"type": "string", "minLength": 1}, "scenario_id": {"type": "string", "minLength": 1},
    "source_result": {"$ref": "#/$defs/reference"}, "source_request": {"$ref": "#/$defs/reference"}, "project_source": {"$ref": "#/$defs/reference"},
    "parameters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/parameter"}},
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["scope", "numeric_leaf_count", "mapped_count", "unmapped_numeric_pointers"],
      "properties": {"scope": {"type": "string", "minLength": 1}, "numeric_leaf_count": {"type": "integer", "minimum": 1}, "mapped_count": {"type": "integer", "minimum": 1}, "unmapped_numeric_pointers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}}
    },
    "scope": {"type": "string", "minLength": 1},
    "source_assertions_authenticated": {"const": false}, "design_accepted": {"const": false}
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["workspace", "path", "sha256"],
      "properties": {"workspace": {"enum": ["tool", "project"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entity_id", "name", "quantity", "source_unit", "source_text", "source_note_pointer", "role", "review_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^bsa-parameter:[0-9a-f]{32}$"}, "entity_id": {"type": "string", "pattern": "^bsa:[0-9a-f]{32}$"},
        "name": {"type": "string", "minLength": 1}, "source_unit": {"type": "string", "minLength": 1}, "source_text": {"type": "string", "minLength": 1},
        "source_note_pointer": {"type": ["string", "null"], "pattern": "^/"}, "role": {"const": "source_input"}, "review_required": {"const": true},
        "quantity": {
          "type": "object", "additionalProperties": false,
          "required": ["value", "unit", "dimension", "si_value", "si_unit", "classification", "source_pointer"],
          "properties": {"value": {"type": "number"}, "si_value": {"type": "number"}, "unit": {"type": "string"}, "si_unit": {"type": "string"}, "dimension": {"type": "string"}, "classification": {"enum": ["declared", "given", "measured", "assumed", "secondary_transcription", "geometry-derived"]}, "source_pointer": {"type": "string", "pattern": "^/"}}
        }
      }
    }
  }
}
