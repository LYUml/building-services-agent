{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "coordinate_frame",
    "units",
    "status",
    "checks",
    "room_id",
    "products",
    "fixtures",
    "totals",
    "native_measurements",
    "native_warnings",
    "geometry_bound",
    "native_calculation_executed",
    "source_assertions_authenticated",
    "regulatory_compliance",
    "design_accepted",
    "pending",
    "report",
    "native_summary"
  ],
  "properties": {
    "schema": {
      "const": "bsa.lighting-source-audit/1"
    },
    "coordinate_frame": {
      "type": "object"
    },
    "units": {
      "const": {
        "power": "W electrical",
        "density": "W electrical/m2",
        "area": "m2",
        "illuminance": "lx"
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_inventory_bound",
        "native_lpd_display_matches"
      ],
      "properties": {
        "source_inventory_bound": {
          "const": true
        },
        "native_lpd_display_matches": {
          "type": "boolean"
        }
      }
    },
    "room_id": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "quantity",
          "input_power_W",
          "classification",
          "source",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "input_power_W": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "classification": {
            "enum": [
              "declared",
              "given",
              "assumed"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "pointer"
            ],
            "properties": {
              "role": {
                "enum": [
                  "design",
                  "layout",
                  "area_evidence",
                  "native_metrics"
                ]
              },
              "pointer": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product_id",
          "input_power_W"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "input_power_W": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_count",
        "luminaire_input_W",
        "auxiliary_allowance_W",
        "budget_input_W",
        "reported_floor_area_m2",
        "annotation_area_m2",
        "calculated_lpd_W_m2",
        "budget_density_W_m2",
        "annotation_budget_density_W_m2",
        "native_reported_lpd_W_m2"
      ],
      "properties": {
        "fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "luminaire_input_W": {
          "type": "number",
          "minimum": 0
        },
        "auxiliary_allowance_W": {
          "type": "number",
          "minimum": 0
        },
        "budget_input_W": {
          "type": "number",
          "minimum": 0
        },
        "reported_floor_area_m2": {
          "type": "number",
          "minimum": 0
        },
        "annotation_area_m2": {
          "type": "number",
          "minimum": 0
        },
        "calculated_lpd_W_m2": {
          "type": "number",
          "minimum": 0
        },
        "budget_density_W_m2": {
          "type": "number",
          "minimum": 0
        },
        "annotation_budget_density_W_m2": {
          "type": "number",
          "minimum": 0
        },
        "native_reported_lpd_W_m2": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "native_measurements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "native_warnings": {
      "type": "array"
    },
    "geometry_bound": {
      "const": false
    },
    "native_calculation_executed": {
      "const": false
    },
    "source_assertions_authenticated": {
      "const": false
    },
    "regulatory_compliance": {
      "const": "not_established"
    },
    "design_accepted": {
      "const": false
    },
    "pending": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "native_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
