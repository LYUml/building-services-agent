{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "request", "project_id", "scenario_id", "capability", "provider", "execution", "acceptance", "inputs", "artifacts", "payload_schema", "payload", "design_accepted"],
  "properties": {
    "schema": {"const": "bsa.module-result/1"},
    "request": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "project_id": {"type": "string", "minLength": 1}, "scenario_id": {"type": "string", "minLength": 1}, "capability": {"type": "string", "minLength": 1},
    "provider": {"type": "object", "additionalProperties": false, "required": ["id", "version", "license"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "license": {"type": "string", "minLength": 1}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["status", "diagnostics"], "properties": {"status": {"enum": ["completed", "failed", "unavailable", "pending"]}, "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["status", "scope"], "properties": {"status": {"enum": ["pass", "fail", "pending"]}, "scope": {"type": "string", "minLength": 1}}},
    "inputs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "payload_schema": {"type": "string", "minLength": 1}, "payload": {"type": ["object", "null"]}, "design_accepted": {"const": false}
  }
}
