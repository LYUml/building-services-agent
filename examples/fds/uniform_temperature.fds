&HEAD CHID='uniform_temperature'/
&MESH IJK=5,5,5, XB=0,1,0,1,0,1/
&TIME T_END=1.0, DT=0.05, LOCK_TIME_STEP=T/
&MISC TMPA=22.5, STRATIFICATION=F, GVEC(3)=0, NOISE=F/
&RADI RADIATION=F/
&DUMP DT_DEVC=0.2/
&DEVC XYZ=0.5,0.5,0.5, QUANTITY='TEMPERATURE', ID='center'/
&DEVC XYZ=0.3,0.3,0.3, QUANTITY='TEMPERATURE', ID='off_center'/
&TAIL/
