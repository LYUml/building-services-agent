<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DatabaseOnly Condition="'$(Automation)' == 'true'">true</DatabaseOnly>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>Building Services Agent</Product>
    <AssemblyTitle>Building Services Agent Revit Adapter</AssemblyTitle>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName Condition="'$(DatabaseOnly)' == 'true'">Bsa.Revit.Database</AssemblyName>
    <AssemblyName Condition="'$(Automation)' == 'true'">Bsa.Revit.Automation</AssemblyName>
    <RevitPath Condition="'$(RevitPath)' == ''">C:\Program Files\Autodesk\Revit 2027</RevitPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitPath)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI" Condition="'$(DatabaseOnly)' != 'true'"><HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Compile Remove="CreatePipeCommand.cs;InventoryCommand.cs;DesktopNativePipes.cs" Condition="'$(DatabaseOnly)' == 'true'" />
    <Compile Remove="AutomationInventory.cs;AutomationCreatePipe.cs" Condition="'$(Automation)' != 'true'" />
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="[2027.0.0]"
                      ExcludeAssets="runtime" Condition="'$(Automation)' == 'true'" />
  </ItemGroup>
</Project>
